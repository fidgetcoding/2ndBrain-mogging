#!/usr/bin/env bash
# bin/save: the gate /save goes through for anything under 05-Tasks/.
# It does not capture conversations, that part is the skill. It answers one
# question: does this edit keep every task ID byte-for-byte?
#
#   save check-tasks --before FILE --after FILE
#       Exit 0 if the edit keeps the ID rule, 1 with the reasons if not.
#   save write-tasks --target 05-Tasks/X.md --from FILE [--yes] [--vault PATH]
#       The same check against what is on disk, then a preview and a prompt, then
#       a backup and the write. Refuses anything outside 05-Tasks/.
set -u

SELF="$0"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link" ;; *) SELF="$(dirname "$SELF")/$link" ;; esac
done
# shellcheck source=bin/lib/vault-gate.sh
. "$(cd -P "$(dirname "$SELF")" && pwd)/lib/vault-gate.sh"

usage() { sed -n '2,10p' "$SELF" | sed 's/^# \{0,1\}//' >&2; exit 2; }

[ $# -ge 1 ] || usage
cmd="$1"
shift
before="" after="" target="" from="" yes=0
while [ $# -gt 0 ]; do
  case "$1" in
    --before)
      [ "$#" -ge 2 ] && [ -n "${2:-}" ] || { echo "missing value for $1" >&2; exit 2; };
      before="${2:-}"; shift 2 ;;
    --after)
      [ "$#" -ge 2 ] && [ -n "${2:-}" ] || { echo "missing value for $1" >&2; exit 2; };
      after="${2:-}"; shift 2 ;;
    --target)
      [ "$#" -ge 2 ] && [ -n "${2:-}" ] || { echo "missing value for $1" >&2; exit 2; };
      target="${2:-}"; shift 2 ;;
    --from)
      [ "$#" -ge 2 ] && [ -n "${2:-}" ] || { echo "missing value for $1" >&2; exit 2; };
      from="${2:-}"; shift 2 ;;
    --vault)
      [ "$#" -ge 2 ] && [ -n "${2:-}" ] || { echo "missing value for $1" >&2; exit 2; };
      export VAULT_DIR="${2:-}"; shift 2 ;;
    --yes)    yes=1; shift ;;
    *) usage ;;
  esac
done

case "$cmd" in
  check-tasks)
    [ -n "$before" ] && [ -f "$after" ] || usage
    if ! gate_check_task_ids "$before" "$after"; then
      echo "UUID rule broken, nothing was written." >&2
      exit 1
    fi
    ;;
  write-tasks)
    [ -n "$target" ] && [ -f "$from" ] || usage
    vault="$(gate_vault_dir)" || exit 2
    verdict="$(gate_check_path save "$target" "$vault")" || { echo "$verdict" >&2; exit 3; }
    regime="${verdict%% *}"
    rel="${verdict#* }"
    if [ "$regime" != "SYNC" ]; then
      echo "refused: write-tasks only writes under 05-Tasks/, and $rel is not." >&2
      exit 3
    fi
    work="$(mktemp -d -t mogging-save.XXXXXX)" || exit 1
    tmp=""
    trap 'rm -rf "$work"; [ -z "$tmp" ] || rm -f "$tmp"' EXIT
    existed=0
    if [ -f "$vault/$rel" ]; then
      existed=1
      cp -p "$vault/$rel" "$work/before" || exit 1
    else
      : > "$work/before"
    fi
    cp "$from" "$work/after" || exit 1
    if ! gate_check_task_ids "$work/before" "$work/after"; then
      echo "UUID rule broken, nothing was written." >&2
      exit 1
    fi
    if [ "$existed" = 1 ] && cmp -s "$work/before" "$work/after"; then
      echo "No change to $rel"
      exit 0
    fi
    if [ "$yes" != "1" ]; then
      diff -u "$work/before" "$work/after" || true
    fi
    gate_confirm "$yes" || { echo "Nothing written."; exit 0; }
    # Refuse stale previews and changed symlink routes rather than overwriting
    # edits made while the confirmation prompt was open.
    current="$(gate_check_path save "$target" "$vault")" || exit 3
    [ "$current" = "$verdict" ] || { echo "Target path changed; retry." >&2; exit 3; }
    unchanged() {
      if [ "$existed" = 1 ]; then cmp -s "$work/before" "$vault/$rel"
      else [ ! -e "$vault/$rel" ] && [ ! -L "$vault/$rel" ]; fi
    }
    unchanged || { echo "Target changed since preview; nothing written." >&2; exit 1; }
    if [ "$existed" = 1 ]; then
      gate_backup "$vault" "$rel" || { echo "Backup failed, nothing written." >&2; exit 1; }
    fi
    mkdir -p "$(dirname "$vault/$rel")" || exit 1
    tmp="$(mktemp "$vault/$rel.tmp.XXXXXX")" || exit 1
    if [ "$existed" = 1 ]; then cp -p "$work/before" "$tmp" || exit 1; fi
    cat "$work/after" > "$tmp" || exit 1
    unchanged || { echo "Target changed; nothing written." >&2; exit 1; }
    if [ "$existed" = 1 ]; then mv "$tmp" "$vault/$rel" || exit 1
    else ln "$tmp" "$vault/$rel" || exit 1; fi
    echo "Wrote $rel"
    ;;
  *) usage ;;
esac
